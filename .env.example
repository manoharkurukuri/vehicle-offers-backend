# ---- Application ----
APP_NAME=Vehicle Offer Extraction API
APP_ENV=production
API_V1_PREFIX=/api/v1
APP_TIMEZONE=America/Los_Angeles

# ---- Database ----
# Local dev default is SQLite. In AWS use RDS (MySQL) instead, e.g.:
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@your-db.abc123.us-east-1.rds.amazonaws.com:3306/vehicle_offers
DATABASE_URL=sqlite:///./vehicle_offers.db

# ---- Storage ----
LOCAL_STORAGE_DIR=./storage/offers

# ---- Groq LLM (required) ----
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_STRUCTURED_OUTPUT_METHOD=function_calling
GROQ_TIMEOUT_SECONDS=120
GROQ_MAX_RETRIES=2
MAX_BODY_CHARS=350000

# ---- Scraping ----
# Must be true on a headless server (no display).
PLAYWRIGHT_HEADLESS=true
SCRAPE_TIMEOUT_SECONDS=60
# Optional ScrapingBee fallback.
SCRAPINGBEE_API_KEY=
SCRAPINGBEE_ENDPOINT=https://app.scrapingbee.com/api/v1/
SCRAPINGBEE_TIMEOUT_SECONDS=90

# ---- Observability (optional) ----
# When absent, Logfire instruments locally without sending data.
LOGFIRE_TOKEN=
