# ---- Application ----
APP_NAME=Vehicle Offer Extraction API
APP_ENV=production
API_V1_PREFIX=/api/v1
APP_TIMEZONE=America/Los_Angeles

# ---- Database ----
# Local dev default is SQLite. In AWS use RDS (MySQL) instead, e.g.:
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@your-db.abc123.us-east-1.rds.amazonaws.com:3306/vehicle_offers
DATABASE_URL=sqlite:///./vehicle_offers.db

# ---- Storage ----
LOCAL_STORAGE_DIR=./storage/offers

# ---- Groq LLM (required) ----
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_STRUCTURED_OUTPUT_METHOD=function_calling
GROQ_TIMEOUT_SECONDS=120
GROQ_MAX_RETRIES=2
MAX_BODY_CHARS=350000

# ---- Scraper Lambda (Playwright runs remotely in AWS Lambda) ----
AWS_REGION=ap-south-2
SCRAPER_LAMBDA_NAME=vehicle_offer_scraper
SCRAPER_LAMBDA_INVOKE_TIMEOUT=180
# Backend needs credentials that allow lambda:InvokeFunction on the scraper.
# On AWS use an IAM role instead of static keys.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---- Cloudinary (stores generated Excel workbooks) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=vehicle-offers

# ---- Observability (optional) ----
# When absent, Logfire instruments locally without sending data.
LOGFIRE_TOKEN=
